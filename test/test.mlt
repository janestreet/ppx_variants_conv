module Mutable_portable_error : sig
  type t =
    | Foo
    | Bar of int ref
  [@@deriving variants ~fold ~portable]
end = struct
  type t =
    | Foo
    | Bar of int ref
  [@@deriving variants ~fold]
end

[%%expect
  {|
Line _, characters _-_:
Error: Signature mismatch:
       ...
       ...
       In module Variants:
       Values do not match:
         val fold :
           init:'a ->
           foo:('a -> t Variant.t @ contended -> 'b) ->
           bar:('b -> (int ref -> t) Variant.t -> 'c) -> 'c
       is not included in
         val fold :
           init:'acc__0 ->
           foo:('acc__0 -> t Variant.t -> 'acc__1) ->
           bar:('acc__1 -> (int ref -> t) Variant.t -> 'acc__2) -> 'acc__2 @@
           portable
       The type
         init:'a ->
         foo:('a -> t Variant.t @ contended -> 'b) ->
         bar:('b -> (int ref -> t) Variant.t -> 'c) -> 'c
       is not compatible with the type
         init:'a ->
         foo:('a -> t Variant.t -> 'b) ->
         bar:('b -> (int ref -> t) Variant.t -> 'd) -> 'd
       Type t Variant.t @ contended -> 'b is not compatible with type
         t Variant.t -> 'b
       File "test.mlt", lines 596-599, characters 2-39: Expected declaration
       File "test.mlt", lines 601-604, characters 2-29: Actual declaration
|}]

