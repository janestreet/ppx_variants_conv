module With_map = struct
  type t =
    | Nullary
    | Tuple of int * string
    | Inline_record of { value : int }
  [@@deriving variants ~map]

  let describe =
    Variants.map
      ~nullary:(fun _ -> "nullary")
      ~tuple:(fun _ int string -> Int.to_string int ^ string)
      ~inline_record:(fun _ ~value -> Int.to_string value)
  ;;
end

[%%expect
  {|
module With_map :
  sig
    type t =
        Nullary
      | Tuple of int * string
      | Inline_record of { value : int; }
    val nullary : t
    val tuple : int -> string -> t
    val inline_record : value:int -> t
    val is_nullary : t -> bool
    val is_tuple : t -> bool
    val is_inline_record : t -> bool
    val nullary_val : t -> unit option
    val tuple_val : t -> (int * string) option
    val inline_record_val : t -> [> `value of int ] option
    module Variants :
      sig
        val nullary : t Variant.t
        val tuple : (int -> string -> t) Variant.t
        val inline_record : (value:int -> t) Variant.t
        val map :
          t ->
          nullary:(t Variant.t -> 'a) ->
          tuple:((int -> string -> t) Variant.t -> int -> string -> 'a) ->
          inline_record:((value:int -> t) Variant.t -> value:int -> 'a) -> 'a
        val to_rank : t @ local -> int
        val to_name : t -> string
        val descriptions : (string * int) list
      end
    val describe : t -> string
  end
|}]

