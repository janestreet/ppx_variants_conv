module Matcher_shapes = struct
  type t =
    | Nullary
    | Tuple of int * string
    | Inline_record of { value : int }
  [@@deriving variants ~make_matcher]

  let matcher =
    Variants.make_matcher
      ~nullary:(fun _ () -> (fun () -> "nullary"), ())
      ~tuple:(fun _ () -> (fun int string -> Int.to_string int ^ string), ())
      ~inline_record:(fun _ () -> (fun ~value -> Int.to_string value), ())
      ()
    |> fst
  ;;

  let results = List.map matcher [ Nullary; Tuple (1, "x"); Inline_record { value = 2 } ]

  let () =
    match results with
    | [ "nullary"; "1x"; "2" ] -> ()
    | _ -> assert false
  ;;
end

[%%expect
  {|
module Matcher_shapes :
  sig
    type t =
        Nullary
      | Tuple of int * string
      | Inline_record of { value : int; }
    val nullary : t
    val tuple : int -> string -> t
    val inline_record : value:int -> t
    val is_nullary : t -> bool
    val is_tuple : t -> bool
    val is_inline_record : t -> bool
    val nullary_val : t -> unit option
    val tuple_val : t -> (int * string) option
    val inline_record_val : t -> [> `value of int ] option
    module Variants :
      sig
        val nullary : t Variant.t
        val tuple : (int -> string -> t) Variant.t
        val inline_record : (value:int -> t) Variant.t
        val make_matcher :
          nullary:(t Variant.t -> 'a -> (unit -> 'b) * 'c) ->
          tuple:((int -> string -> t) Variant.t ->
                 'c -> (int -> string -> 'b) * 'd) ->
          inline_record:((value:int -> t) Variant.t ->
                         'd -> (value:int -> 'b) * 'e) ->
          'a -> (t -> 'b) * 'e
        val to_rank : t @ local -> int
        val to_name : t -> string
        val descriptions : (string * int) list
      end
    val matcher : t -> string
    val results : string list
  end
|}]

module Poly_matcher = struct
  type t =
    [ `Nullary
    | `Tuple of int * string
    ]
  [@@deriving variants ~make_matcher]

  let matcher =
    Variants.make_matcher
      ~nullary:(fun _ () -> (fun () -> "nullary"), ())
      ~tuple:(fun _ () -> (fun (int, string) -> Int.to_string int ^ string), ())
      ()
    |> fst
  ;;

  let () =
    match matcher `Nullary, matcher (`Tuple (3, "y")) with
    | "nullary", "3y" -> ()
    | _ -> assert false
  ;;
end

[%%expect
  {|
module Poly_matcher :
  sig
    type t = [ `Nullary | `Tuple of int * string ]
    val nullary : [> `Nullary ]
    val tuple : 'a -> [> `Tuple of 'a ]
    val is_nullary : [> `Nullary ] -> bool
    val is_tuple : [> `Tuple of 'a ] -> bool
    val nullary_val : [> `Nullary ] -> unit option
    val tuple_val : [> `Tuple of 'a ] -> 'a option
    module Variants :
      sig
        val nullary : [> `Nullary ] Variant.t
        val tuple : ('a -> [> `Tuple of 'a ]) Variant.t
        val make_matcher :
          nullary:([> `Nullary ] Variant.t -> 'a -> (unit -> 'b) * 'c) ->
          tuple:(('d -> [> `Tuple of 'd ]) Variant.t -> 'c -> ('e -> 'b) * 'f) ->
          'a -> ([< `Nullary | `Tuple of 'e ] -> 'b) * 'f
        val to_rank : [< `Nullary | `Tuple of 'a ] @ local -> int
        val to_name : [< `Nullary | `Tuple of 'a ] -> string
        val descriptions : (string * int) list
      end
    val matcher : [ `Nullary | `Tuple of int * string ] -> string
  end
|}]

module Combined_flags = struct
  type t = A [@@deriving variants ~make_matcher ~fold ~iter ~map]

  let mapped = Variants.map A ~a:(fun _ -> ())
  let folded = Variants.fold ~init:0 ~a:(fun acc _ -> acc + 1)
  let iterated = Variants.iter ~a:(fun _ -> ())
  let matcher = Variants.make_matcher ~a:(fun _ () -> (fun () -> ()), ()) () |> fst
end

[%%expect
  {|
module Combined_flags :
  sig
    type t = A
    val a : t
    val is_a : t -> bool
    val a_val : t -> unit option
    module Variants :
      sig
        val a : t Variant.t
        val fold : init:'a -> a:('a -> t Variant.t -> 'b) -> 'b
        val iter : a:(t Variant.t -> unit) -> unit
        val map : t -> a:(t Variant.t -> 'a) -> 'a
        val make_matcher :
          a:(t Variant.t -> 'a -> (unit -> 'b) * 'c) -> 'a -> (t -> 'b) * 'c
        val to_rank : t @ local -> int
        val to_name : t -> string
        val descriptions : (string * int) list
      end
    val mapped : unit
    val folded : int
    val iterated : unit
    val matcher : t -> unit
  end
|}]

module Normal = struct
  type t =
